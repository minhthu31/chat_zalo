@implements IDisposable
@inject ProfileCache Profiles
@inject ApiRequestSender Api
@inject PresenceState Presence
@using global::Chat.Client.Services
@using global::Chat.Client.State

@* Ảnh đại diện của một người. Có ảnh thì hiện ảnh, chưa có (hoặc chưa tải được) thì hiện chữ cái đầu của tên. *@
@if (ShowPresence)
{
    var status = Presence.Find(UserId);
    <span class="presence-avatar">
        @Avatar
        @if (status?.IsOnline == true)
        {
            <span class="presence-dot" role="img" aria-label="@status.Label" title="@status.Label"></span>
        }
    </span>
}
else
{
    @Avatar
}

@code {
    private RenderFragment Avatar => @<text>
@if (_src is not null)
{
    <img class="avatar @SizeClass avatar-img" src="@_src" alt="@DisplayName" @onerror="UseInitial" />
}
else
{
    <span class="avatar @SizeClass" aria-label="@DisplayName">@AvatarText.From(DisplayName)</span>
}
    </text>;

    [Parameter] public bool ShowPresence { get; set; }

    protected override void OnInitialized() => Presence.Changed += OnPresenceChanged;

    private void OnPresenceChanged()
    {
        if (ShowPresence) _ = InvokeAsync(StateHasChanged);
    }
    [Parameter, EditorRequired]
    public Guid UserId { get; set; }

    [Parameter]
    public string DisplayName { get; set; } = "";

    // "sm" (nhỏ, thanh điều hướng), "" (vừa) hoặc "lg" (lớn, trang hồ sơ)
    [Parameter]
    public string Size { get; set; } = "";

    private string? _src;
    private Guid _loadedFor;

    private string SizeClass => Size == "" ? "" : $"avatar-{Size}";

    protected override async Task OnParametersSetAsync()
    {
        // Chỉ hỏi lại khi đổi sang người khác; đổi ảnh được báo qua sự kiện Changed bên dưới
        if (UserId == _loadedFor)
            return;

        Profiles.Changed -= OnProfileChanged;
        _loadedFor = UserId;
        Profiles.Changed += OnProfileChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _src = null;

        if (UserId == Guid.Empty)
            return;

        var userId = UserId;
        var version = Profiles.VersionOf(userId);
        var profile = await Profiles.GetAsync(userId);
        if (userId == UserId && version == Profiles.VersionOf(userId) && profile?.AvatarUrl is { Length: > 0 } url)
            _src = Api.ToAbsoluteUri(url) + "?v=" + version;
    }

    private void UseInitial() => _src = null;

    private void OnProfileChanged(Guid changed)
    {
        if (changed == UserId)
            _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose()
    {
        Profiles.Changed -= OnProfileChanged;
        Presence.Changed -= OnPresenceChanged;
    }
}
