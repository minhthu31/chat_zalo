@implements IAsyncDisposable
@inject IJSRuntime JS
@using global::Chat.Client.Models
<ul @ref="_element" class="messages" aria-label="Tin nhắn">
    @if (Items.Count == 0) { <li>Chưa có tin nhắn.</li> }
    @foreach (var message in Items)
    {
        <li @key="message.Id" class="@(message.SenderUserId == CurrentUserId ? "mine" : "")">
            <strong>@SenderLabel(message)</strong>
            <p>@message.Body</p><small>#@message.Seq · @message.CreatedAt.ToLocalTime().ToString("HH:mm")</small>
        </li>
    }
</ul>
@code {
    [Parameter] public Guid ConversationId { get; set; }
    [Parameter] public bool HasOlder { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnLoadOlder { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MessageList>? _reference;
    private bool _disposed;
    private bool _requestingOlder;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_module is null)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/message-history.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            _reference = DotNetObjectReference.Create(this);
        }
        await _module.InvokeVoidAsync("bind", _element, _reference, ConversationId.ToString(), HasOlder && !Loading, Items.Count);
    }
    [JSInvokable]
    public async Task LoadOlderFromScroll()
    {
        if (_disposed || _requestingOlder || Loading || !HasOlder) return;
        _requestingOlder = true;
        try { await OnLoadOlder.InvokeAsync(); }
        finally { _requestingOlder = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("unbind", _element); }
            catch (JSDisconnectedException) { }
            await _module.DisposeAsync();
        }
        _reference?.Dispose();
    }

    [Parameter] public IReadOnlyList<MessageResponse> Items { get; set; } = [];
    [Parameter] public Guid CurrentUserId { get; set; }

    // Tên người gửi theo mã người dùng (dùng cho chat nhóm, nơi có nhiều người gửi)
    [Parameter] public IReadOnlyDictionary<Guid, string>? SenderNames { get; set; }

    // Hiện khi không biết tên người gửi: chat 1-1 là "Đối phương", chat nhóm là người đã rời nhóm
    [Parameter] public string UnknownSenderLabel { get; set; } = "Đối phương";

    private string SenderLabel(MessageResponse message)
    {
        if (message.SenderUserId == CurrentUserId)
            return "Bạn";

        return SenderNames is not null && SenderNames.TryGetValue(message.SenderUserId, out var name)
            ? name
            : UnknownSenderLabel;
    }
}
