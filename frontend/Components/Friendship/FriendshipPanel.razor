@using Chat.Client.Models
@using Chat.Client.Services
@inject IFriendshipApiClient FriendshipApi

@if (_loading)
{
    <div class="card"><p class="muted center">Đang tải...</p></div>
}
else if (_loadError is not null)
{
    <div class="card">
        <p role="alert" class="alert alert-error">@_loadError</p>
        <button class="btn btn-primary btn-block" @onclick="ReloadAsync">Thử lại</button>
    </div>
}
else
{
    @if (_actionError is not null)
    {
        <p role="alert" class="alert alert-error">@_actionError</p>
    }

    <div class="card">
        <h2 class="section-title">Bạn bè (@_friends.Count)</h2>
        @if (_friends.Count == 0)
        {
            <p class="muted">Chưa có bạn bè.</p>
        }
        @foreach (var f in _friends)
        {
            <div class="list-item">
                <span class="person">
                    <span class="person-name">@f.DisplayName</span>
                    <span class="muted">@@@f.Username</span>
                </span>
                <span class="actions">
                    <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => RunAsync(() => FriendshipApi.RemoveAsync(f.UserId))">Hủy kết bạn</button>
                </span>
            </div>
        }
    </div>

    <div class="card">
        <h2 class="section-title">Lời mời nhận được (@_incoming.Count)</h2>
        @if (_incoming.Count == 0)
        {
            <p class="muted">Không có lời mời nào.</p>
        }
        @foreach (var f in _incoming)
        {
            <div class="list-item">
                <span class="person">
                    <span class="person-name">@f.DisplayName</span>
                    <span class="muted">@@@f.Username</span>
                </span>
                <span class="actions">
                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => RunAsync(() => FriendshipApi.AcceptAsync(f.UserId))">Chấp nhận</button>
                    <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => RunAsync(() => FriendshipApi.RejectAsync(f.UserId))">Từ chối</button>
                </span>
            </div>
        }
    </div>

    <div class="card">
        <h2 class="section-title">Lời mời đã gửi (@_outgoing.Count)</h2>
        @if (_outgoing.Count == 0)
        {
            <p class="muted">Chưa gửi lời mời nào.</p>
        }
        @foreach (var f in _outgoing)
        {
            <div class="list-item">
                <span class="person">
                    <span class="person-name">@f.DisplayName</span>
                    <span class="muted">@@@f.Username</span>
                </span>
                <span class="actions">
                    <button class="btn btn-sm" disabled="@_busy" @onclick="() => RunAsync(() => FriendshipApi.RemoveAsync(f.UserId))">Hủy lời mời</button>
                </span>
            </div>
        }
    </div>
}

@code {
    private List<FriendshipDto> _friends = new();
    private List<FriendshipDto> _incoming = new();
    private List<FriendshipDto> _outgoing = new();
    private bool _loading = true;
    private bool _busy;
    private string? _loadError;
    private string? _actionError;

    protected override Task OnInitializedAsync() => ReloadAsync();

    // Public để trang chứa panel (ví dụ UserSearch) gọi làm mới sau khi gửi lời mời
    public async Task ReloadAsync()
    {
        _loadError = null;
        try
        {
            _friends = await FriendshipApi.GetFriendsAsync();
            var requests = await FriendshipApi.GetRequestsAsync();
            _incoming = requests.Incoming;
            _outgoing = requests.Outgoing;
        }
        catch (ApiException ex)
        {
            _loadError = FriendshipErrors.ToMessage(ex.Code);
        }
        finally
        {
            _loading = false;
        }
        StateHasChanged();
    }

    // Chạy một thao tác (accept/reject/remove) rồi tải lại danh sách; lỗi hiển thị theo code
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _actionError = null;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            _actionError = FriendshipErrors.ToMessage(ex.Code);
        }
        finally
        {
            _busy = false;
        }
    }
}
