@namespace Chat.Client.Components.Messaging
@implements IAsyncDisposable
@using global::Chat.Client.Models
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
<form class="composer" @onsubmit="() => OnSend.InvokeAsync()" @onsubmit:preventDefault>
    <label for="chat-body">Tin nhắn</label>
    <textarea id="chat-body" @ref="_textarea" value="@Body" @oninput="UpdateBody" maxlength="4000" rows="3"
              disabled="@(Disabled || Retry)" placeholder="Nhập tin nhắn…"></textarea>

    @if (Files.Count > 0)
    {
        <ul class="file-chips" aria-label="Tệp sẽ gửi">
            @foreach (var file in Files)
            {
                <li @key="file.LocalId" class="file-chip">
                    <span class="file-chip-name" title="@file.Name">@file.Name</span>
                    <small>@AttachmentLimits.FormatSize(file.Size)@(file.Uploaded is not null ? " · đã tải lên" : "")</small>
                    <button type="button" class="file-chip-remove" aria-label="Bỏ tệp @file.Name"
                            disabled="@Disabled" @onclick="() => RemoveFileAsync(file)">×</button>
                </li>
            }
        </ul>
        <small class="muted">@Files.Count/@AttachmentLimits.MaxFiles tệp · tổng @AttachmentLimits.FormatSize(Files.Sum(f => f.Size)) / 50 MB</small>
    }

    @if (_fileError is not null) { <p role="alert" class="alert alert-error">@_fileError</p> }
    @if (!string.IsNullOrEmpty(UploadStatus)) { <p role="status" class="alert alert-info">@UploadStatus</p> }

    <div><small>@Body.Length / 4.000</small>
        <span class="composer-actions">
            <label class="btn btn-sm file-btn @(Disabled ? "disabled" : "")" title="Đính kèm ảnh hoặc tệp (tối đa 5 tệp, 10 MB mỗi tệp, 50 MB mỗi tin)">
                📎 Đính kèm
                <InputFile @ref="_input" OnChange="OnFilesChosenAsync" multiple accept="@AttachmentLimits.Accept"
                           disabled="@Disabled" class="file-input-hidden" />
            </label>
            <button class="btn btn-primary" type="submit" disabled="@(Disabled || (string.IsNullOrWhiteSpace(Body) && Files.Count == 0))">@(Retry ? "Thử gửi lại" : "Gửi tin nhắn")</button>
        </span>
    </div>
    @if (Retry) { <small>Nội dung được giữ nguyên để thử lại an toàn sau lỗi mạng.</small> }
</form>
@code {
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public EventCallback<string> BodyChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Retry { get; set; }
    [Parameter] public EventCallback OnSend { get; set; }

    // Danh sách tệp đã chọn của hội thoại này (cùng một danh sách với trạng thái hội thoại, nên không mất khi chuyển hội thoại)
    [Parameter] public List<OutgoingFile> Files { get; set; } = new();
    [Parameter] public EventCallback OnFilesChanged { get; set; }

    // "Đang tải lên 2/3: ten.pdf" khi đang gửi
    [Parameter] public string? UploadStatus { get; set; }

    private string? _fileError;
    private InputFile? _input;
    private ElementReference _textarea;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat-composer.js");
        await _module.InvokeVoidAsync("enableEnterToSend", _textarea);
    }

    private Task UpdateBody(ChangeEventArgs e) => BodyChanged.InvokeAsync(e.Value?.ToString() ?? "");

    // Chọn tệp xong thì kiểm tra từng tệp (số lượng, loại, dung lượng) ngay ở FE, tệp nào đạt mới thêm vào danh sách
    private async Task OnFilesChosenAsync(InputFileChangeEventArgs e)
    {
        var problems = new List<string>();
        IReadOnlyList<IBrowserFile> chosen;

        try
        {
            chosen = e.GetMultipleFiles(AttachmentLimits.MaxFiles + 10);
        }
        catch (InvalidOperationException)
        {
            chosen = [];
            problems.Add($"Mỗi lần chỉ chọn tối đa {AttachmentLimits.MaxFiles} tệp.");
        }

        foreach (var browserFile in chosen)
        {
            var problem = AttachmentRules.CheckCanAdd(Files, browserFile.Name, browserFile.Size);
            if (problem is not null)
            {
                problems.Add(problem);
                continue;
            }

            var file = browserFile;
            Files.Add(new OutgoingFile
            {
                Name = file.Name,
                Size = file.Size,
                ContentType = AttachmentLimits.ContentTypeFor(file.Name)!,
                Open = () => file.OpenReadStream(AttachmentLimits.MaxFileBytes)
            });
        }

        _fileError = problems.Count == 0 ? null : string.Join(" ", problems);

        // Xóa lựa chọn của ô (không thay phần tử) để chọn lại đúng tệp này lần sau vẫn nhận được
        try
        {
            if (_input?.Element is { } element)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat-composer.js");
                await _module.InvokeVoidAsync("resetInput", element);
            }
        }
        catch (JSException)
        {
            // Không quan trọng: chỉ ảnh hưởng việc chọn lại đúng tệp cũ ngay lập tức
        }

        await OnFilesChanged.InvokeAsync();
    }

    private IJSObjectReference? _module;

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task RemoveFileAsync(OutgoingFile file)
    {
        Files.Remove(file);
        _fileError = null;
        await OnFilesChanged.InvokeAsync();
    }
}
