@using global::Chat.Client.Models
<nav aria-label="Hội thoại">
    @if (Items.Count == 0) { <p>Chưa có hội thoại.</p> }
    @foreach (var item in Items)
    {
        <button type="button" class="conversation @(item.Id == Selected ? "active" : "")"
                disabled="@Disabled" @onclick="() => OnSelect.InvokeAsync(item.Id)">
            Hội thoại @item.Id.ToString()[..8] <small>@item.Kind</small>
        </button>
    }
</nav>
@code {
    [Parameter] public IReadOnlyList<ConversationDto> Items { get; set; } = [];
    [Parameter] public Guid Selected { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }
}
