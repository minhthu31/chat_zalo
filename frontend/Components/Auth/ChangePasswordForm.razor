@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Chat.Client.Models
@using Chat.Client.Services
@inject IAuthApiClient AuthApi

<EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="change-password">
    <DataAnnotationsValidator />

    <div class="field">
        <label for="current-password">Mật khẩu hiện tại</label>
        <InputText id="current-password" type="@(_showPassword ? "text" : "password")" autocomplete="current-password" @bind-Value="_model.CurrentPassword" />
        <ValidationMessage For="() => _model.CurrentPassword" />
    </div>

    <div class="field">
        <label for="new-password">Mật khẩu mới</label>
        <InputText id="new-password" type="@(_showPassword ? "text" : "password")" autocomplete="new-password" @bind-Value="_model.NewPassword" />
        <ValidationMessage For="() => _model.NewPassword" />
        <p class="hint">Mật khẩu cần ít nhất 6 ký tự, có chữ hoa, chữ số và ký tự đặc biệt (ví dụ Passw0rd!x).</p>
    </div>

    <div class="field">
        <label for="confirm-password">Nhập lại mật khẩu mới</label>
        <InputText id="confirm-password" type="@(_showPassword ? "text" : "password")" autocomplete="new-password" @bind-Value="_model.ConfirmPassword" />
        <ValidationMessage For="() => _model.ConfirmPassword" />
        <label class="show-pw"><input type="checkbox" @bind="_showPassword" /> Hiện mật khẩu</label>
    </div>

    @if (_error is not null)
    {
        <p role="alert" class="alert alert-error">@_error</p>
    }

    <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">@(_busy ? "Đang đổi mật khẩu..." : "Đổi mật khẩu")</button>
</EditForm>

@code {
    // Đổi xong thì backend đã đăng xuất phiên hiện tại. Trang chứa form sẽ lo việc dọn trạng thái và chuyển sang trang Login.
    [Parameter] public EventCallback OnSuccess { get; set; }

    private readonly ChangePasswordInput _model = new();
    private string? _error;
    private bool _busy;
    private bool _showPassword;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            // Chỉ gửi 2 trường theo hợp đồng. Ô "nhập lại" chỉ để kiểm tra ở phía FE, không gửi lên server.
            await AuthApi.ChangePasswordAsync(new ChangePasswordRequest
            {
                CurrentPassword = _model.CurrentPassword,
                NewPassword = _model.NewPassword
            });
            await OnSuccess.InvokeAsync();
        }
        catch (ApiException ex)
        {
            // Xử lý theo Code, không so sánh chuỗi Message
            _error = ex.Code switch
            {
                "INVALID_CURRENT_PASSWORD" => "Mật khẩu hiện tại không đúng.",
                "VALIDATION_ERROR" => "Mật khẩu mới chưa đáp ứng yêu cầu.",
                "INVALID_CSRF_TOKEN" => "Phiên làm việc hết hạn, vui lòng tải lại trang.",
                "UNAUTHORIZED" => "Bạn chưa đăng nhập hoặc phiên đã hết hạn, vui lòng đăng nhập lại.",
                "NETWORK_ERROR" => "Không kết nối được máy chủ, vui lòng thử lại.",
                _ => "Không thể đổi mật khẩu, vui lòng thử lại."
            };
        }
        finally
        {
            _busy = false;
        }
    }

    private class ChangePasswordInput
    {
        [Required(ErrorMessage = "Vui lòng nhập mật khẩu hiện tại.")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu mới.")]
        [RegularExpression(@"^(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{6,256}$",
            ErrorMessage = "Mật khẩu cần ít nhất 6 ký tự, có chữ hoa, chữ số và ký tự đặc biệt.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập lại mật khẩu mới.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Mật khẩu nhập lại không khớp.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
