@page "/register"
@using global::Chat.Client.Components.Auth
@inject NavigationManager Nav

<div class="as-root">
    <div class="page page-narrow">
        <div class="card">
            <h1 class="page-title">Đăng ký</h1>

            <RegisterForm OnSuccess="GoLogin" />

            <p class="muted center">Đã có tài khoản? <a href="login">Đăng nhập</a></p>
        </div>
    </div>
</div>

@code {
    // Đăng ký không tự đăng nhập nên chuyển sang trang Login
    private void GoLogin() => Nav.NavigateTo("/login");
}
