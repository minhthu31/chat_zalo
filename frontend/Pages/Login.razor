@page "/login"
@using global::Chat.Client.Components.Auth
@inject NavigationManager Nav

<div class="as-root">
    <div class="page page-narrow">
        <div class="card">
            <h1 class="page-title">Đăng nhập</h1>

            <LoginForm OnSuccess="GoHome" />

            <p class="muted center">Chưa có tài khoản? <a href="register">Đăng ký</a></p>
        </div>
    </div>
</div>

@code {
    private void GoHome() => Nav.NavigateTo("/");
}
