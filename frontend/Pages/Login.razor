@page "/login"
@using global::Chat.Client.Components.Auth
@inject NavigationManager Nav

<div class="as-root auth-center">
    <div class="page page-narrow">
        <div class="brand">
            <div class="brand-logo">C</div>
            <div class="brand-name">chat_zalo</div>
            <div class="brand-tagline">Kết nối bạn bè, trò chuyện mọi lúc</div>
        </div>

        <div class="card">
            <h1 class="page-title">Đăng nhập</h1>

            @if (Changed)
            {
                <p class="alert alert-success">Đổi mật khẩu thành công. Vui lòng đăng nhập lại bằng mật khẩu mới.</p>
            }

            <LoginForm OnSuccess="GoHome" />

            <p class="muted center">Chưa có tài khoản? <a href="register">Đăng ký</a></p>
        </div>
    </div>
</div>

@code {
    // Trang đổi mật khẩu chuyển sang đây bằng /login?changed=true để hiện dòng thông báo thành công
    [Parameter]
    [SupplyParameterFromQuery]
    public bool Changed { get; set; }

    private void GoHome() => Nav.NavigateTo("/chat");
}
