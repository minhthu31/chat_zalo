@page "/chat"
@using global::Chat.Client.Models
@using global::Chat.Client.Services
@using global::Chat.Client.State
@using global::Chat.Client.Components.Auth
@using global::Chat.Client.Components.Friendship
@using global::Chat.Client.Components.Messaging
@using global::Chat.Client.Components.Conversations
@using global::Chat.Client.Components.Messages
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject AuthState Auth
@inject ApiRequestSender RequestSender
@inject IFriendshipApiClient FriendshipApi
@inject IGroupApiClient GroupApi
@inject IAttachmentApiClient AttachmentApi
@inject IMessageReceiptApiClient ReceiptApi
@inject IBlockApiClient BlockApi
@inject IJSRuntime JS
@inject NotificationService Notifications
@inject HttpClient Http

<PageTitle>Tin nhắn · chat_zalo</PageTitle>
<link rel="stylesheet" href="css/chat.css" />
<div class="as-root chat-root">
<section class="chat-shell">
    @if (!initializing) { <UserBar /> }
    <header class="chat-heading">
        <div class="brand-mark">C</div>
        <div><span class="chat-brand">chat_zalo</span><h1>Tin nhắn</h1><p>Kết nối bạn bè, trò chuyện mọi lúc</p></div>
    </header>
    @if (initializing) { <p class="alert alert-info" role="status">Đang kiểm tra phiên đăng nhập…</p> }
    else if (!Auth.IsAuthenticated)
    {
        <div class="card chat-welcome"><h2>Đăng nhập để trò chuyện</h2><p class="muted">Tin nhắn và hội thoại được lưu bằng API trên hệ thống.</p><a class="btn btn-primary" href="/login">Đăng nhập</a></div>
    }
    else if (session is not null)
    {
        <div class="chat-connection" role="status"><span class="connection-label"><i class="@(connected ? "online" : "")"></i>@connectionStatus</span>
            <button class="btn btn-sm" @onclick="RefreshAsync" disabled="@refreshing">@(refreshing ? "Đang đồng bộ…" : "Kết nối / đồng bộ lại")</button>
        </div>
        <div class="chat-layout direct-layout">
            <aside class="chat-sidebar">
                <h2 class="section-title">Hội thoại <small>(@conversations.Count)</small></h2>
                <div class="new-conversation">
                    <FriendChatSearch OnOpen="OpenWithFriendAsync" Disabled="@(creating || refreshing)" />
                </div>
                @if (refreshing && conversations.Count == 0) { <p class="muted">Đang tải hội thoại…</p> }
                else
                {
                    <ConversationList Items="conversations" Titles="conversationTitles" Selected="@(session.State.SelectedId ?? Guid.Empty)" OnSelect="SelectAsync" />
                }
            </aside>
            <main class="chat-main">
                @if (session.State.SelectedId is Guid id && session.State.Active is { } active)
                {
                    <div class="chat-topbar"><span class="avatar">@ConversationTitle(id)[..1].ToUpperInvariant()</span><div><h2>@ConversationTitle(id)</h2><small class="muted">@(IsGroup(id) ? (membersFor == id ? $"Nhóm · {senderNames.Count} thành viên · " : "Nhóm · ") : "Trò chuyện cá nhân · ")Tin nhắn được lưu trên hệ thống</small></div>@if (IsGroup(id)) { <a class="btn btn-sm" href="/groups/@id">Xem nhóm</a> }<ConversationMuteButton ConversationId="id" /></div>
                    @if (active.Loading) { <p class="chat-loading" role="status">Đang tải tin nhắn…</p> }
                    <button class="btn btn-sm older" @onclick="LoadOlderAsync" disabled="@(!active.HasOlder || active.Loading)">Tải tin nhắn cũ hơn</button>
                    <MessageList Items="active.Messages" CurrentUserId="Auth.CurrentUser!.Id"
                                 SenderNames="@(IsGroup(id) ? senderNames : null)"
                                 Attachments="active.Extras().Attachments"
                                 StatusFor="@(m => receipts?.StatusFor(id, m, Auth.CurrentUser!.Id, IsGroup(id), blockedByMe))"
                                 ConversationId="id" HasOlder="active.HasOlder" Loading="active.Loading" OnLoadOlder="LoadOlderAsync"
                                 OnSeen="@(ids => OnMessagesSeenAsync(id, ids))"
                                 UnknownSenderLabel="@(IsGroup(id) ? "Thành viên đã rời nhóm" : "Đối phương")" />
                    @if (errors.TryGetValue(id, out var sendError)) { <p class="alert alert-error" role="alert">@sendError</p> }
                    @if (sendPermissions.TryGetValue(id, out var canSend) && !canSend) { <p class="muted">Bạn cần đang là bạn bè và bỏ chặn để gửi tin nhắn.</p> }
                    <ChatComposer @key="id" Body="@active.Draft" BodyChanged="value => active.Draft = value"
                                  Retry="@(active.Pending is not null)" Disabled="@(active.Sending || !active.Initialized || (sendPermissions.TryGetValue(id, out var allowed) && !allowed))" OnSend="SendAsync"
                                  Files="active.Extras().Files" OnFilesChanged="OnFilesChangedAsync" UploadStatus="@active.Extras().UploadStatus" />
                }
                else { <div class="chat-empty"><span class="brand-mark">C</span><h2>Chào mừng đến chat_zalo</h2><p>Chọn một hội thoại hoặc bắt đầu trò chuyện với bạn bè.</p></div> }
            </main>
            @if (session.State.SelectedId is Guid detailsId && conversationPeers.TryGetValue(detailsId, out var peer))
            {
                <ConversationDetails @key="detailsId" Peer="peer" Revision="detailsRevision" OnChanged="RefreshFriendshipsAsync" CanSendChanged="value => sendPermissions[detailsId] = value" />
            }
        </div>
    }
    @if (error is not null) { <p class="alert alert-error chat-global-error" role="alert">@error</p> }
    <NewMessageToasts Items="toasts" OnOpen="OpenToastAsync" OnDismiss="DismissToast" />
</section>
</div>

@code {
    // Ticket yêu cầu tải 10 tin mỗi lần (cả chat 1-1 lẫn nhóm), cuộn lên để tải thêm
    private const int PageSize = 10;

    // Mở thẳng một hội thoại từ địa chỉ /chat?c={id} (ví dụ nút "Nhắn tin" ở trang nhóm)
    [Parameter]
    [SupplyParameterFromQuery(Name = "c")]
    public Guid? OpenConversationId { get; set; }

    private ChatSession? session;
    private ChatHubClient? hub;
    private ConversationsApiClient? conversationsApi;
    private GroupAwareConversations? groupConversations;
    private ConversationDiscovery? discovery;

    // Tên các thành viên của nhóm đang xem, để hiện "ai gửi" trong tin nhắn nhóm
    private Dictionary<Guid, string> senderNames = [];
    private bool IsGroup(Guid id) => conversations.Any(c => c.Id == id && c.Kind == "Group");
    private readonly CancellationTokenSource discoveryLifetime = new();
    private Task? discoveryLoop;
    private int conversationRevision;
    private List<ConversationDto> conversations = [];
    private Dictionary<Guid, string> conversationTitles = [];
    private Dictionary<Guid, ConversationTitleDto> conversationPeers = [];
    private readonly Dictionary<Guid, bool> sendPermissions = [];
    private int detailsRevision;
    private async Task RefreshFriendshipsAsync()
    {
        try { friends = await FriendshipApi.GetFriendsAsync(); }
        catch (Exception ex) { error = Describe(ex); }
    }
    private string ConversationTitle(Guid id) => conversationTitles.GetValueOrDefault(id, "Trò chuyện cá nhân");

    private async Task RefreshTitlesAsync()
    {
        try
        {
            var titles = await RequestSender.SendAsync<List<ConversationTitleDto>>(HttpMethod.Get, "api/conversations/direct/titles");
            if (!disposed && Auth.IsAuthenticated)
            {
                conversationTitles = titles.ToDictionary(t => t.ConversationId, t => t.Title);
                conversationPeers = titles.ToDictionary(t => t.ConversationId);
                detailsRevision++;
            }
        }
        catch (Exception ex) { if (!disposed) error = "Chưa tải được tên hội thoại: " + Describe(ex); }

        // Tên các nhóm lấy từ GroupAwareConversations (API tiêu đề chỉ có chat 1-1)
        if (!disposed && groupConversations is not null)
            foreach (var (groupId, name) in groupConversations.GroupNames)
                conversationTitles[groupId] = name;
    }

    private Guid? membersFor;   // nhóm mà senderNames đang chứa tên thành viên

    // Tải tên thành viên của nhóm để hiện người gửi. force = true khi có tin mới (có thể có người vừa vào/rời nhóm)
    private async Task EnsureMembersAsync(Guid id, bool force = false)
    {
        if (!IsGroup(id) || (!force && membersFor == id)) return;
        try
        {
            var members = await GroupApi.GetMembersAsync(id);
            if (disposed || session?.State.SelectedId != id) return;
            senderNames = members.ToDictionary(m => m.UserId, m => m.DisplayName);
            membersFor = id;
        }
        catch (ApiException) { /* chưa có tên thì tin nhắn hiện nhãn chung, không làm hỏng chat */ }
    }
    private List<FriendshipDto> friends = [];
    private Guid targetFriend;
    private readonly Dictionary<Guid, string> errors = [];
    private bool initializing = true, refreshing, creating, disposed, connected;
    private string connectionStatus = "Chưa kết nối";
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += OnAuthChanged;
        conversationsApi = new ConversationsApiClient(RequestSender);
        messagesApi = new MessagesApiClient(RequestSender, PageSize);
        session = new ChatSession(messagesApi, PageSize);
        attachmentCoordinator = new AttachmentCoordinator(session, AttachmentApi);
        receipts = new ReceiptCoordinator(session, ReceiptApi);
        hub = new ChatHubClient(Http);
        hub.ConversationChanged += OnChanged;
        hub.Reconnected += OnReconnected;
        hub.ReceiptChanged += OnReceiptChanged;
        hub.StatusChanged += OnConnectionChanged;
        hub.SubscriptionFailed += OnSubscriptionFailed;
        groupConversations = new GroupAwareConversations(conversationsApi, GroupApi);
        discovery = new ConversationDiscovery(groupConversations, hub.JoinAsync);
        discovery.SubscriptionFailed += OnSubscriptionFailed;
        try { if (!Auth.IsInitialized) await Auth.InitializeAsync(); }
        catch (Exception ex) { error = Describe(ex); }
        initializing = false;
        if (Auth.IsAuthenticated)
        {
            await LoadBlockedAsync();
            await RefreshAsync();
            if (!disposed && !discoveryLifetime.IsCancellationRequested)
                discoveryLoop = DiscoverConversationsAsync(discoveryLifetime.Token);
        }
    }

    private void OnAuthChanged()
    {
        if (!Auth.IsAuthenticated) _ = InvokeAsync(async () =>
        {
            if (disposed) return;
            discoveryLifetime.Cancel();
            session?.Reset();
            conversations.Clear();
            conversationTitles.Clear();
            conversationPeers.Clear();
            sendPermissions.Clear();
            senderNames.Clear();
            toasts.Clear();
            Notifications.Forget();
            membersFor = null;
            friends.Clear();
            errors.Clear();
            if (hub is not null) await hub.DisposeAsync();
            if (!disposed) StateHasChanged();
        });
    }

    private Task OnConnectionChanged(HubConnectionState state) => InvokeAsync(() =>
    {
        connected = state == HubConnectionState.Connected;
        connectionStatus = state switch
        {
            HubConnectionState.Connected => "Realtime đã kết nối",
            HubConnectionState.Connecting => "Đang kết nối…",
            HubConnectionState.Reconnecting => "Mất kết nối — đang thử nối lại…",
            _ => "Mất kết nối — bấm kết nối lại; vẫn có thể gửi qua API"
        };
        if (!disposed) StateHasChanged();
    });

    private Task OnSubscriptionFailed(Exception ex) => InvokeAsync(() =>
    {
        if (disposed) return;
        error = "Không đăng ký được thông báo cho một hội thoại. Bấm đồng bộ lại để thử lại. " + Describe(ex);
        StateHasChanged();
    });

    private readonly List<ToastItem> toasts = [];
    private IJSObjectReference? notifyModule;
    private MessagesApiClient? messagesApi;
    private AttachmentCoordinator? attachmentCoordinator;

    private async Task<IJSObjectReference> NotifyModuleAsync() =>
        notifyModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/notify.js");

    // Có tin mới ở một hội thoại: báo bằng banner và âm thanh, TRỪ KHI đang xem đúng hội thoại đó hoặc đã tắt thông báo.
    // Tắt thông báo chỉ tắt phần báo này; tin vẫn được nhận và lưu bình thường (hợp đồng Sprint 3, mục 4).
    private async Task NotifyIfNeededAsync(Guid conversationId, long previousSeq, long latestSeq)
    {
        if (disposed || latestSeq <= previousSeq || messagesApi is null || Auth.CurrentUser is null) return;

        try
        {
            var module = await NotifyModuleAsync();
            // Đang xem đúng hội thoại này (và đang nhìn trang): RunAsync đã đồng bộ và báo "đã xem", không cần banner
            if (session?.State.SelectedId == conversationId && await module.InvokeAsync<bool>("isActive")) return;

            // Lấy tin mới: vừa để biết ai gửi, vừa là lúc "thiết bị đã lấy được dữ liệu tin" nên báo ĐÃ NHẬN lên backend.
            // Báo "đã nhận" làm cả khi hội thoại đã tắt thông báo: tắt thông báo chỉ tắt âm/banner, không ngừng xác nhận.
            var after = previousSeq > 0 ? previousSeq : Math.Max(0, latestSeq - 1);
            var fresh = await messagesApi.GetNewAsync(conversationId, after);
            var visible = fresh.Where(m => m.ConversationId == conversationId).OrderBy(m => m.Seq).ToList();
            if (visible.Count == 0) return;
            if (receipts is not null) await receipts.MarkDeliveredAsync(conversationId, IsGroup(conversationId), Auth.CurrentUser.Id, visible);

            if (await Notifications.IsMutedAsync(conversationId)) return;

            // Tin do chính mình gửi (ví dụ từ thiết bị khác) thì không báo
            var last = visible[^1];
            if (last.SenderUserId == Auth.CurrentUser.Id) return;

            var text = string.IsNullOrWhiteSpace(last.Body)
                ? "Đã gửi một tệp đính kèm"
                : last.Body.Length > 80 ? last.Body[..80] + "…" : last.Body;

            AddToast(new ToastItem(Guid.NewGuid(), conversationId, ConversationTitle(conversationId), text));
            await module.InvokeVoidAsync("beep");
        }
        catch (Exception)
        {
            // Báo tin là phụ: lỗi mạng hoặc trình duyệt chặn âm thanh không được làm hỏng chat
        }
    }

    private bool networkErrorShown;   // dòng lỗi đang hiện là lỗi mạng (sẽ tự mất khi kết nối lại)
    private ReceiptCoordinator? receipts;
    private HashSet<Guid> blockedByMe = [];
    private IDisposable? activityReference;

    // Người mình đã chặn không xem được tin của mình nên không tính là "đã nhận/đã xem" tin đó
    private async Task LoadBlockedAsync()
    {
        try { blockedByMe = (await BlockApi.GetAsync()).Select(b => b.UserId).ToHashSet(); }
        catch (ApiException) { /* không có danh sách chặn thì vẫn hiện trạng thái, chỉ kém chính xác khi có chặn */ }
    }

    // Báo lên backend: đã NHẬN tin tới seq lớn nhất đang có; và nếu người dùng đang NHÌN trang này thì đã XEM tới đó
    private async Task MarkReceiptsAsync(Guid id)
    {
        if (receipts is null || session is null || disposed) return;

        var me = Auth.CurrentUser?.Id ?? Guid.Empty;
        var messages = session.State.For(id).Messages.ToList();
        if (messages.Count == 0) return;
        var group = IsGroup(id);

        await receipts.MarkDeliveredAsync(id, group, me, messages);

        // Nhóm: "đã xem" KHÔNG báo ở đây. Chỉ báo cho những tin đang nằm trong vùng nhìn thấy (xem OnMessagesSeenAsync),
        // vì tin cũ vừa hiện lại phía trên (sau khi bỏ chặn, hoặc vừa tải thêm) chưa được người dùng nhìn tới.
        if (group) return;

        try
        {
            var module = await NotifyModuleAsync();
            if (session.State.SelectedId == id && await module.InvokeAsync<bool>("isActive"))
                await receipts.MarkReadAsync(id, group, me, messages);
        }
        catch (Exception)
        {
            // Không đọc được trạng thái trang: bỏ qua, lần sau báo
        }
    }

    // Chat nhóm: danh sách tin đang nằm trong vùng nhìn thấy (trang đang hoạt động) -> báo "đã xem" đúng những tin đó
    private async Task OnMessagesSeenAsync(Guid conversationId, IReadOnlyList<Guid> ids)
    {
        if (disposed || receipts is null || session is null || Auth.CurrentUser is null) return;
        if (session.State.SelectedId != conversationId || !IsGroup(conversationId)) return;

        var seenIds = ids.ToHashSet();
        var seen = session.State.For(conversationId).Messages.Where(m => seenIds.Contains(m.Id)).ToList();
        if (seen.Count == 0) return;

        // Xác nhận "đã xem" chỉ cho các tin đang nhìn thấy (xác nhận "xem" của backend cũng ghi luôn "nhận")
        await receipts.MarkReadAsync(conversationId, true, Auth.CurrentUser.Id, seen);
    }

    // Có người đổi mốc đã nhận/đã xem (SignalR): cập nhật chữ dưới tin
    private Task OnReceiptChanged(MessageReceiptChanged change) => InvokeAsync(async () =>
    {
        if (disposed || receipts is null || !Auth.IsAuthenticated) return;
        if (!receipts.Apply(change, Auth.CurrentUser!.Id)) await receipts.LoadAsync(change.ConversationId, IsGroup(change.ConversationId), Auth.CurrentUser.Id); // người mới chưa có tên: hỏi API để ghép tên
        if (!disposed) StateHasChanged();
    });

    // Người dùng quay lại trang (bấm vào cửa sổ, chuyển lại tab): lúc đó mới tính là "đã xem" các tin đến khi họ vắng mặt
    [JSInvokable]
    public Task OnPageActivated() => InvokeAsync(async () =>
    {
        if (disposed || session?.State.SelectedId is not Guid id) return;
        await MarkReceiptsAsync(id);
        if (!disposed) StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed) return;

        try
        {
            var module = await NotifyModuleAsync();
            activityReference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("watchActivity", activityReference);
        }
        catch (Exception)
        {
            // Không theo dõi được: vẫn báo "đã xem" khi mở hội thoại, chỉ kém chính xác khi quay lại tab
        }
    }

    private void AddToast(ToastItem toast)
    {
        toasts.Add(toast);
        if (toasts.Count > 3) toasts.RemoveAt(0);

        // Tự tắt sau 7 giây
        _ = Task.Delay(TimeSpan.FromSeconds(7)).ContinueWith(_ => InvokeAsync(() =>
        {
            if (disposed) return;
            toasts.Remove(toast);
            StateHasChanged();
        }));
    }

    private void DismissToast(ToastItem toast) => toasts.Remove(toast);

    private Task OpenToastAsync(ToastItem toast)
    {
        toasts.Remove(toast);
        return SelectAsync(toast.ConversationId);
    }

    private Task OnChanged(ConversationChanged change) => InvokeAsync(async () =>
    {
        if (disposed || session is null || !Auth.IsAuthenticated) return;
        // Ghi lại mốc cũ TRƯỚC khi làm mới danh sách, để biết có tin mới thật hay không
        var previousSeq = conversations.FirstOrDefault(c => c.Id == change.ConversationId)?.LastMessageSeq ?? 0;
        if (!conversations.Any(c => c.Id == change.ConversationId)) await RefreshAsync();
        conversations = conversations.Select(c => c.Id == change.ConversationId
            ? c with { LastMessageSeq = Math.Max(c.LastMessageSeq, change.LatestSeq) } : c).ToList();
        if (session.State.SelectedId == change.ConversationId)
        {
            await RunAsync(change.ConversationId, () => session.SyncAsync(change.ConversationId));
            await EnsureMembersAsync(change.ConversationId, force: true);
        }
        await NotifyIfNeededAsync(change.ConversationId, previousSeq, change.LatestSeq);
        if (!disposed) StateHasChanged();
    });

    private Task OnReconnected() => InvokeAsync(async () =>
    {
        if (disposed || session is null || !Auth.IsAuthenticated) return;
        // Kết nối lại: cài đặt thông báo có thể đã đổi trên thiết bị khác nên đọc lại từ backend
        Notifications.Forget();
        if (session.State.SelectedId is Guid id)
        {
            await RunAsync(id, () => IsGroup(id) ? session.RefreshVisibleAsync(id) : session.SyncAsync(id));
            await Notifications.RefreshAsync(id);
            // Hợp đồng: kết nối lại thì Join lại -> đồng bộ tin (xong ở trên) -> tải lại mốc đã nhận/đã xem và cài đặt thông báo
            if (receipts is not null) await receipts.LoadAsync(id, IsGroup(id), Auth.CurrentUser!.Id);
        }
        await LoadBlockedAsync();
        if (!disposed) StateHasChanged();
    });

    private async Task DiscoverConversationsAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    if (disposed || !Auth.IsAuthenticated || refreshing || creating || discovery is null || session is null) return;
                    var revision = conversationRevision;
                    try
                    {
                        var items = await discovery.RefreshAsync(ct);
                        if (disposed || ct.IsCancellationRequested || !Auth.IsAuthenticated || revision != conversationRevision) return;
                        // Gọi được backend trở lại: bỏ dòng báo "mất kết nối" cũ (chỉ loại lỗi mạng, giữ các thông báo quan trọng khác)
                        if (networkErrorShown) { error = null; networkErrorShown = false; }
                        items = items.Where(c => c.Kind is "Direct" or "Group").ToList();
                        // Nhóm đang xem vừa biến mất khỏi danh sách (rời nhóm, bị xóa, nhóm giải tán): phải ghi nhận
                        // TRƯỚC khi cập nhật danh sách, để báo cho người dùng biết vì sao chat chuyển sang hội thoại khác
                        var lostGroup = session.State.SelectedId is Guid watching && IsGroup(watching) && !items.Any(c => c.Id == watching);
                        conversations = items;
                        await RefreshTitlesAsync();
                        if (lostGroup)
                            error = "Bạn không còn trong nhóm đang xem (đã rời nhóm, bị xóa khỏi nhóm hoặc nhóm đã giải tán).";
                        if (session.State.SelectedId is Guid selected && !items.Any(c => c.Id == selected))
                            session.State.SelectedId = null;
                        if (session.State.SelectedId is Guid id)
                        {
                            // Catch messages sent before JoinConversation completed, or while the hub was offline.
                            if (IsGroup(id))
                                await RunAsync(id, () => session.RefreshVisibleAsync(id)).WaitAsync(ct);
                            else if (items.Any(c => c.Id == id && c.LastMessageSeq > session.State.For(id).SyncedSeq))
                                await RunAsync(id, () => session.SyncAsync(id)).WaitAsync(ct);
                        }
                        else if (items.Count > 0) await SelectAsync(items[0].Id).WaitAsync(ct);
                    }
                    catch (OperationCanceledException) when (ct.IsCancellationRequested) { return; }
                    catch (Exception ex)
                    {
                        if (disposed || ct.IsCancellationRequested) return;
                        if (ex is ApiException { StatusCode: 401 })
                        {
                            discoveryLifetime.Cancel();
                            session.Reset();
                            conversations.Clear();
                            friends.Clear();
                        }
                        error = Describe(ex);
                        networkErrorShown = ex is ApiException { Code: "NETWORK_ERROR" };
                    }
                    if (!disposed) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private async Task RefreshAsync()
    {
        if (refreshing || disposed || session is null || discovery is null || !Auth.IsAuthenticated) return;
        var owner = session;
        refreshing = true;
        error = null;
        try
        {
            conversationRevision++;
            var items = await discovery.RefreshAsync(discoveryLifetime.Token);
            if (disposed || !Auth.IsAuthenticated) return;
            conversations = items.Where(c => c.Kind is "Direct" or "Group").ToList();
            await RefreshTitlesAsync();
            try { friends = await FriendshipApi.GetFriendsAsync(); }
            catch (Exception ex) { error = "Chưa tải được danh sách bạn bè: " + Describe(ex); }
            if (disposed || !Auth.IsAuthenticated) return;
            if (owner.State.SelectedId is Guid old && !conversations.Any(c => c.Id == old)) owner.State.SelectedId = null;
            // Failure of the hub must not prevent reading or sending through REST.
            if (hub is not null)
            {
                try
                {
                    await hub.StartAsync();
                }
                catch (Exception ex) { error = "Realtime chưa sẵn sàng: " + Describe(ex); }
            }
            if (disposed || !Auth.IsAuthenticated) return;
            if (owner.State.SelectedId is Guid id)
            {
                await RunAsync(id, () => IsGroup(id) ? owner.RefreshVisibleAsync(id) : owner.SyncAsync(id));
                await EnsureMembersAsync(id);
            }
            else if (OpenConversationId is Guid wanted && conversations.Any(c => c.Id == wanted)) await SelectAsync(wanted);
            else if (conversations.Count > 0) await SelectAsync(conversations[0].Id);
        }
        catch (OperationCanceledException) when (discoveryLifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (!disposed)
            {
                if (ex is ApiException { StatusCode: 401 })
                {
                    discoveryLifetime.Cancel();
                    owner.Reset();
                    conversations.Clear();
                    friends.Clear();
                }
                error = Describe(ex);
            }
        }
        finally { refreshing = false; }
    }

    // Bấm "Nhắn tin" ở một người bạn trong ô tìm kiếm: mở (hoặc tạo) cuộc trò chuyện 1-1 với người đó
    private Task OpenWithFriendAsync(Guid friendId)
    {
        targetFriend = friendId;
        return CreateAsync();
    }

    private async Task CreateAsync()
    {
        if (creating || refreshing || targetFriend == Guid.Empty || conversationsApi is null || session is null) return;
        creating = true;
        conversationRevision++;
        error = null;
        try
        {
            var conversation = await conversationsApi.CreateDirectAsync(targetFriend);
            if (disposed || !Auth.IsAuthenticated) return;
            conversationRevision++;
            if (!conversations.Any(c => c.Id == conversation.Id)) conversations.Add(conversation);
            await RefreshTitlesAsync();
            if (hub is not null)
                try { await hub.JoinAsync(conversation.Id); }
                catch (Exception ex) { error = "Realtime chưa sẵn sàng: " + Describe(ex); }
            await SelectAsync(conversation.Id);
        }
        catch (Exception ex) { if (!disposed) error = Describe(ex); }
        finally { creating = false; }
    }

    private async Task SelectAsync(Guid id)
    {
        if (disposed || session is null || !Auth.IsAuthenticated) return;
        var owner = session;
        owner.State.SelectedId = id;
        await RunAsync(id, () => IsGroup(id) ? owner.RefreshVisibleAsync(id) : owner.SyncAsync(id));
        await EnsureMembersAsync(id);
        if (receipts is not null) await receipts.LoadAsync(id, IsGroup(id), Auth.CurrentUser!.Id); // mốc đã nhận/đã xem của những người trong hội thoại
    }

    private Task LoadOlderAsync()
    {
        var owner = session;
        return owner?.State.SelectedId is Guid id ? RunAsync(id, () => owner.LoadOlderAsync(id)) : Task.CompletedTask;
    }
    private Task SendAsync()
    {
        var owner = session;
        if (owner?.State.SelectedId is not Guid id) return Task.CompletedTask;

        // Có tệp được chọn thì gửi tin kèm tệp (tải lên rồi gửi), không thì gửi tin chữ như cũ
        if (owner.State.For(id).Extras().Files.Count > 0 && attachmentCoordinator is not null)
            return RunAsync(id, () => attachmentCoordinator.SendWithFilesAsync(id, () => _ = InvokeAsync(StateHasChanged)));

        return RunAsync(id, () => owner.SendAsync(id));
    }

    // Người dùng thêm/bỏ tệp trong ô soạn tin: vẽ lại để hiện danh sách tệp
    private Task OnFilesChangedAsync() => Task.CompletedTask;

    private async Task RunAsync(Guid id, Func<Task> operation)
    {
        var owner = session;
        errors.Remove(id);
        try
        {
            await operation();
            // Tin vừa tải/đồng bộ về có thể kèm tệp: hỏi backend để hiện ảnh/tệp (lỗi thì bỏ qua, tin chữ vẫn hiện)
            if (attachmentCoordinator is not null) await attachmentCoordinator.EnrichAsync(id);
            // Đã lấy được tin về máy: báo "đã nhận"; nếu đang mở hội thoại này và nhìn thấy trang thì báo "đã xem"
            if (session?.State.SelectedId == id)
            {
                // Nhóm: tin mới về máy (trang tin cũ vừa cuộn lên, tin hiện lại sau khi bỏ chặn) thì hỏi trạng thái người nhận/xem của
                // đúng những tin đó trước, rồi mới báo "đã nhận" (để biết tin nào mình đã báo rồi)
                if (receipts is not null && IsGroup(id) && Auth.CurrentUser is not null) await receipts.LoadMissingAsync(id, Auth.CurrentUser.Id);
                await MarkReceiptsAsync(id);
            }
        }
        catch (Exception ex)
        {
            if (disposed || owner != session) return;
            // Bị chặn (hoặc đã chặn người kia khi gửi): chỉ báo lỗi cho hội thoại này, không reset cả phiên chat
            if (ex is ApiException { StatusCode: 403, Code: "CONVERSATION_ACCESS_DENIED" })
                errors[id] = "Bạn không thể gửi hoặc xem tin nhắn trong hội thoại này vì một trong hai người đã chặn người kia.";
            // Nhóm: đã rời, bị xóa khỏi nhóm hoặc nhóm đã giải tán. Cũng chỉ báo lỗi hội thoại này
            else if (ex is ApiException { StatusCode: 403, Code: "GROUP_ACCESS_DENIED" })
                errors[id] = "Bạn không còn quyền trong nhóm này (đã rời nhóm, bị xóa khỏi nhóm hoặc nhóm đã giải tán).";
            else if (ex is ApiException { StatusCode: 401 or 403 })
            {
                owner?.Reset();
                conversations.Clear();
                error = Describe(ex);
            }
            else
            {
                // Lỗi không phải của API (ví dụ lỗi đọc tệp): người dùng thấy câu chung, chi tiết ghi ra Console của trình duyệt để dễ tìm lỗi
                if (ex is not ApiException and not AttachmentSendException) Console.Error.WriteLine($"[chat] {ex}");
                errors[id] = Describe(ex);
            }
        }
    }

    private static string Describe(Exception ex) => ex switch
    {
        ApiException { StatusCode: 401 } => "Phiên đăng nhập hết hạn. Vui lòng đăng nhập lại.",
        AttachmentSendException attachment => attachment.Message,
        ApiException { Code: "NETWORK_ERROR" } => "Mất kết nối tới máy chủ. Tin nhắn sẽ tự đồng bộ khi có mạng lại.",
        ApiException api =>$"{api.Code}: {api.Message}",
        _ => "Không thể hoàn tất yêu cầu. Kiểm tra kết nối và thử lại."
    };

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        discoveryLifetime.Cancel();
        session?.Reset();
        Auth.OnChange -= OnAuthChanged;
        if (discoveryLoop is not null) await discoveryLoop;
        if (hub is not null) await hub.DisposeAsync();
        if (notifyModule is not null)
        {
            try
            {
                await notifyModule.InvokeVoidAsync("unwatchActivity");
                await notifyModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        activityReference?.Dispose();
        discoveryLifetime.Dispose();
    }
}
