@page "/users/search"
@using global::Chat.Client.Components.Auth
@using global::Chat.Client.Components.Friendship
@using global::Chat.Client.Models
@using global::Chat.Client.Services
@inject IUserApiClient UserApi
@inject IFriendshipApiClient FriendshipApi

<div class="as-root">
    <div class="page">
        <UserBar />

        <div class="card">
            <h1 class="page-title">Tìm người dùng</h1>

            <form class="search-row"
                  @onsubmit="SearchAsync"
                  @onsubmit:preventDefault>
                <input @bind="_query"
                       placeholder="Nhập tên đăng nhập" />

                <button type="submit"
                        class="btn btn-primary"
                        disabled="@_searching">
                    @(_searching ? "Đang tìm..." : "Tìm")
                </button>
            </form>

            @if (_error is not null)
            {
                <p role="alert" class="alert alert-error">
                    @_error
                </p>
            }
            else if (_searched && _results.Count == 0)
            {
                <p class="muted center">
                    Không tìm thấy người dùng nào.
                </p>
            }

            @if (_notice is not null)
            {
                <p class="alert alert-info">@_notice</p>
            }

            @foreach (var user in _results)
            {
                <div class="list-item" @key="user.Id">
                    <span class="person">
                        <span class="avatar">
                            @AvatarText.From(user.DisplayName)
                        </span>

                        <span class="person-text">
                            <span class="person-name">
                                @user.DisplayName
                            </span>
                            <span class="muted">@@@user.Username</span>
                        </span>
                    </span>

                    <span class="actions">
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                disabled="@IsRequestDisabled(user.Id)"
                                @onclick="() => SendRequestAsync(user)">
                            @RequestLabel(user.Id)
                        </button>
                    </span>
                </div>
            }

            @if (_searched && _totalPages > 1)
            {
                <div class="pager">
                    <button type="button"
                            class="btn btn-sm"
                            disabled="@(_searching || _page <= 1)"
                            @onclick="() => GoToPageAsync(_page - 1)">
                        Trước
                    </button>

                    <span class="muted">Trang @_page / @_totalPages · @_totalCount người</span>

                    <button type="button"
                            class="btn btn-sm"
                            disabled="@(_searching || _page >= _totalPages)"
                            @onclick="() => GoToPageAsync(_page + 1)">
                        Sau
                    </button>
                </div>
            }
        </div>

        <FriendshipPanel @ref="_panel"
                         OnChanged="OnFriendshipsChangedAsync" />
    </div>
</div>

@code {
    private FriendshipPanel? _panel;

    private const int PageSize = 10;

    private string _query = "";
    private string _searchedQuery = "";   // từ khóa của lần tìm gần nhất, dùng khi bấm Trước/Sau
    private int _page = 1;
    private int _totalPages;
    private int _totalCount;
    private List<UserDto> _results = new();

    private readonly HashSet<Guid> _sent = new();
    private readonly HashSet<Guid> _friends = new();
    private readonly HashSet<Guid> _incoming = new();

    private bool _relationsReady;
    private bool _searching;
    private bool _searched;
    private bool _sending;

    private string? _error;
    private string? _notice;

    private bool IsRequestDisabled(Guid userId) =>
        _sending
        || !_relationsReady
        || _friends.Contains(userId)
        || _sent.Contains(userId)
        || _incoming.Contains(userId);

    private string RequestLabel(Guid userId)
    {
        if (!_relationsReady)
            return "Chờ đồng bộ";

        if (_friends.Contains(userId))
            return "Bạn bè";

        if (_sent.Contains(userId))
            return "Đã gửi";

        if (_incoming.Contains(userId))
            return "Đã nhận lời mời";

        return "Kết bạn";
    }

    private async Task RefreshFriendshipStateAsync()
    {
        _relationsReady = false;
        _error = null;

        try
        {
            var friends = await FriendshipApi.GetFriendsAsync();
            var requests = await FriendshipApi.GetRequestsAsync();

            _friends.Clear();
            _friends.UnionWith(friends.Select(f => f.UserId));

            _sent.Clear();
            _sent.UnionWith(requests.Outgoing.Select(f => f.UserId));

            _incoming.Clear();
            _incoming.UnionWith(requests.Incoming.Select(f => f.UserId));

            _relationsReady = true;
        }
        catch (ApiException ex)
        {
            _error = FriendshipErrors.ToMessage(ex.Code);
        }
    }

    private async Task OnFriendshipsChangedAsync()
    {
        _notice = null;
        await RefreshFriendshipStateAsync();
    }

    // Bấm "Tìm" hoặc Enter: luôn bắt đầu lại từ trang 1 với từ khóa mới
    private Task SearchAsync() => LoadPageAsync(_query.Trim(), 1);

    // Bấm "Trước" / "Sau": giữ nguyên từ khóa của lần tìm gần nhất, chỉ đổi trang
    private Task GoToPageAsync(int page)
    {
        if (page < 1 || page > _totalPages)
            return Task.CompletedTask;

        return LoadPageAsync(_searchedQuery, page);
    }

    private async Task LoadPageAsync(string query, int page)
    {
        if (_searching)
            return;

        _searching = true;
        _error = null;
        _notice = null;

        try
        {
            var result = await UserApi.SearchPagedAsync(query, page, PageSize);

            _results = result.Items;
            _page = result.Page;
            _totalPages = result.TotalPages;
            _totalCount = result.TotalCount;
            _searchedQuery = query;
            _searched = true;

            await RefreshFriendshipStateAsync();
        }
        catch (ApiException ex)
        {
            _results = new();
            _searched = false;
            _page = 1;
            _totalPages = 0;
            _totalCount = 0;

            _error = ex.Code switch
            {
                "USERNAME_REQUIRED" =>
                    "Vui lòng nhập tên đăng nhập cần tìm.",
                "INVALID_USERNAME" =>
                    "Tên đăng nhập quá dài (tối đa 100 ký tự).",
                "INVALID_PAGE" or "INVALID_PAGE_SIZE" =>
                    "Trang yêu cầu không hợp lệ, vui lòng tìm lại.",
                _ => FriendshipErrors.ToMessage(ex.Code)
            };
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task SendRequestAsync(UserDto user)
    {
        if (IsRequestDisabled(user.Id))
            return;

        _sending = true;
        _error = null;
        _notice = null;

        try
        {
            await FriendshipApi.SendRequestAsync(user.Id);

            _sent.Add(user.Id);
            _notice = $"Đã gửi lời mời tới {user.DisplayName}.";

            if (_panel is not null)
                await _panel.ReloadAsync();

            await RefreshFriendshipStateAsync();
        }
        catch (ApiException ex)
        {
            _notice = FriendshipErrors.ToMessage(ex.Code);

            // Trạng thái có thể đã đổi ở tài khoản hoặc cửa sổ khác.
            await RefreshFriendshipStateAsync();
        }
        finally
        {
            _sending = false;
        }
    }
}