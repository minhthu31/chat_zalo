@page "/users/search"
@using global::Chat.Client.Components.Friendship
@using global::Chat.Client.Models
@using global::Chat.Client.Services
@inject IUserApiClient UserApi
@inject IFriendshipApiClient FriendshipApi

<div class="as-root">
<div class="page">
    <div class="card">
        <h1 class="page-title">Tìm người dùng</h1>

        <form class="search-row" @onsubmit="SearchAsync">
            <input @bind="_query" placeholder="Nhập tên đăng nhập" />
            <button type="submit" class="btn btn-primary" disabled="@_searching">@(_searching ? "Đang tìm..." : "Tìm")</button>
        </form>

        @if (_error is not null)
        {
            <p role="alert" class="alert alert-error">@_error</p>
        }
        else if (_searched && _results.Count == 0)
        {
            <p class="muted center">Không tìm thấy người dùng nào.</p>
        }

        @if (_notice is not null)
        {
            <p class="alert alert-info">@_notice</p>
        }

        @foreach (var u in _results)
        {
            <div class="list-item">
                <span class="person">
                    <span class="person-name">@u.DisplayName</span>
                    <span class="muted">@@@u.Username</span>
                </span>
                <span class="actions">
                    <button class="btn btn-primary btn-sm" disabled="@(_sending || _sent.Contains(u.Id))" @onclick="() => SendRequestAsync(u)">
                        @(_sent.Contains(u.Id) ? "Đã gửi" : "Kết bạn")
                    </button>
                </span>
            </div>
        }
    </div>

    <FriendshipPanel @ref="_panel" />
</div>
</div>

@code {
    private FriendshipPanel? _panel;
    private string _query = "";
    private List<UserDto> _results = new();
    private readonly HashSet<Guid> _sent = new();
    private bool _searching;
    private bool _searched;
    private bool _sending;
    private string? _error;
    private string? _notice;

    private async Task SearchAsync()
    {
        _searching = true;
        _error = null;
        _notice = null;
        try
        {
            _results = await UserApi.SearchAsync(_query.Trim());
            _searched = true;
        }
        catch (ApiException ex)
        {
            _results = new();
            _searched = false;
            _error = ex.Code switch
            {
                "USERNAME_REQUIRED" => "Vui lòng nhập tên đăng nhập cần tìm.",
                "INVALID_USERNAME" => "Tên đăng nhập quá dài (tối đa 100 ký tự).",
                _ => FriendshipErrors.ToMessage(ex.Code)
            };
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task SendRequestAsync(UserDto user)
    {
        _sending = true;
        _notice = null;
        try
        {
            await FriendshipApi.SendRequestAsync(user.Id);
            _sent.Add(user.Id);
            _notice = $"Đã gửi lời mời tới {user.DisplayName}.";
            if (_panel is not null)
                await _panel.ReloadAsync();
        }
        catch (ApiException ex)
        {
            _notice = FriendshipErrors.ToMessage(ex.Code);
        }
        finally
        {
            _sending = false;
        }
    }
}
