@page "/change-password"
@using global::Chat.Client.Components.Auth
@using global::Chat.Client.State
@inject NavigationManager Nav
@inject AuthState Auth

<div class="as-root">
<div class="page page-narrow">
    <UserBar />

    <div class="card">
        <h1 class="page-title">Đổi mật khẩu</h1>

        <ChangePasswordForm OnSuccess="HandleSuccess" />
    </div>
</div>
</div>

@code {
    // Backend đã tự đăng xuất phiên khi đổi mật khẩu thành công,
    // nên chỉ cần xóa trạng thái ở FE rồi đưa người dùng sang Login để đăng nhập lại.
    private void HandleSuccess()
    {
        Auth.ClearSession();
        Nav.NavigateTo("/login?changed=true");
    }
}
