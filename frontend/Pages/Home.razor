@page "/"
@using global::Chat.Client.Services
@using global::Chat.Client.State
@inject AuthState Auth
@inject NavigationManager Nav

<div class="as-root auth-center">
    <p role="status">Đang mở ứng dụng…</p>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.InitializeAsync();
            Nav.NavigateTo(Auth.IsAuthenticated ? "/chat" : "/login", replace: true);
        }
        catch (ApiException)
        {
            // The login screen already handles API/network errors for the user.
            Nav.NavigateTo("/login", replace: true);
        }
    }
}
