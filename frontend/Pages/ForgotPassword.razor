@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using global::Chat.Client.Services
@inject ApiRequestSender Api

<PageTitle>Quên mật khẩu · chat_zalo</PageTitle>

<div class="as-root auth-center auth-entry">
    <div class="page page-narrow">
        <div class="brand">
            <div class="auth-mark" aria-hidden="true"><span></span><span></span></div>
            <div class="brand-name">chat_zalo</div>
        </div>

        <section class="card" aria-labelledby="forgot-password-title">
            <h1 class="page-title" id="forgot-password-title">Quên mật khẩu?</h1>
            @if (_error is not null)
            {
                <p class="alert alert-error" role="alert">@_error</p>
            }

            @if (_reset)
            {
                <p class="alert alert-success" role="status">Mật khẩu đã được đặt lại. Bạn có thể đăng nhập bằng mật khẩu mới.</p>
            }
            else if (!_sent)
            {
                <EditForm Model="_request" OnValidSubmit="SendCodeAsync" FormName="forgot-password">
                    <DataAnnotationsValidator />
                    <div class="field">
                        <label for="recovery-email">Email đã đăng ký</label>
                        <InputText id="recovery-email" type="email" autocomplete="email" maxlength="256" @bind-Value="_request.Email" disabled="@_busy" />
                        <ValidationMessage For="() => _request.Email" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">Gửi mã</button>
                </EditForm>
            }
            else
            {
                <p class="muted" role="status">Nếu email này đã đăng ký, bạn sẽ nhận được mã 6 số. Mã có hiệu lực trong 10 phút.</p>
                <EditForm Model="_password" OnValidSubmit="ResetAsync" FormName="reset-password">
                    <DataAnnotationsValidator />
                    <div class="field">
                        <label for="recovery-code">Mã xác minh</label>
                        <InputText id="recovery-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind-Value="_password.Code" disabled="@_busy" />
                        <ValidationMessage For="() => _password.Code" />
                    </div>
                    <div class="field">
                        <label for="recovery-password">Mật khẩu mới</label>
                        <InputText id="recovery-password" type="password" autocomplete="new-password" maxlength="256" @bind-Value="_password.NewPassword" disabled="@_busy" />
                        <ValidationMessage For="() => _password.NewPassword" />
                        <p class="hint">Ít nhất 6 ký tự, có chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</p>
                    </div>
                    <div class="field">
                        <label for="recovery-confirm">Nhập lại mật khẩu mới</label>
                        <InputText id="recovery-confirm" type="password" autocomplete="new-password" maxlength="256" @bind-Value="_password.ConfirmPassword" disabled="@_busy" />
                        <ValidationMessage For="() => _password.ConfirmPassword" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">Đặt lại mật khẩu</button>
                </EditForm>
                <p class="center auth-switch"><button type="button" class="btn btn-sm" disabled="@_busy" @onclick="ChangeEmail">Đổi email hoặc gửi lại mã</button></p>
            }
            <p class="center auth-switch"><a href="/login">Quay lại đăng nhập</a></p>
        </section>
    </div>
</div>

@code {
    private readonly EmailInput _request = new();
    private PasswordInput _password = new();
    private bool _busy, _sent, _reset;
    private string? _error;

    private async Task SendCodeAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _request.Email = _request.Email.Trim();
            await Api.SendAsync(HttpMethod.Post, "api/auth/forgot-password", _request);
            _sent = true;
        }
        catch (ApiException ex)
        {
            _error = ex.Code == "PASSWORD_RECOVERY_UNAVAILABLE"
                ? "Dịch vụ gửi mã chưa được cấu hình."
                : ex.StatusCode == 429 ? "Bạn đã gửi quá nhiều yêu cầu. Hãy chờ rồi thử lại."
                : "Chưa gửi được yêu cầu lấy mã. Vui lòng thử lại.";
        }
        finally { _busy = false; }
    }

    private async Task ResetAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.SendAsync(HttpMethod.Post, "api/auth/reset-password", new
            {
                _request.Email, _password.Code, _password.NewPassword
            });
            _password = new();
            _reset = true;
        }
        catch (ApiException ex)
        {
            _error = ex.Code switch
            {
                "INVALID_RECOVERY_CODE" => "Mã không đúng hoặc đã hết hiệu lực.",
                "PASSWORD_RESET_FAILED" => "Không đặt được mật khẩu. Kiểm tra yêu cầu mật khẩu rồi gửi lại mã.",
                _ when ex.StatusCode == 429 => "Bạn đã thử quá nhiều lần. Hãy chờ rồi thử lại.",
                _ => "Chưa đặt lại được mật khẩu. Vui lòng thử lại."
            };
        }
        finally { _busy = false; }
    }

    private void ChangeEmail()
    {
        _sent = false;
        _error = null;
        _password = new();
    }

    private sealed class EmailInput
    {
        [Required(ErrorMessage = "Vui lòng nhập email.")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ.")]
        public string Email { get; set; } = "";
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessage = "Vui lòng nhập mã.")]
        [RegularExpression("^[0-9]{6}$", ErrorMessage = "Mã gồm 6 chữ số.")]
        public string Code { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu mới.")]
        [StringLength(256, MinimumLength = 6, ErrorMessage = "Mật khẩu cần từ 6 đến 256 ký tự.")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^a-zA-Z0-9]).+$",
            ErrorMessage = "Mật khẩu cần chữ hoa, chữ thường, chữ số và ký tự đặc biệt.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập lại mật khẩu.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Hai mật khẩu không khớp.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
