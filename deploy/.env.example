# Public hostname only: no https:// and no trailing slash.
CHAT_DOMAIN=chat.example.com
# Replace before running. Use letters/digits and avoid semicolons in the connection string.
POSTGRES_PASSWORD=replace_with_a_long_random_password
# Change both together if this subnet overlaps the server's existing networks.
CHAT_SUBNET=172.30.23.0/24
CHAT_PROXY_IP=172.30.23.10
